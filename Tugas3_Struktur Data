#include <iostream>
#include <string>
using namespace std;

struct Node {
    char data;
    Node* next;
};
struct Stack {
    Node* top;
    Stack() { top = NULL; }
    bool isEmpty() { return top == NULL; }
    void push(char c) {
        Node* baru = new Node;
        baru->data = c;
        baru->next = top;   
        top = baru;         
    }
    char pop() {
        if (isEmpty()) {
            cout << "Stack kosong!" << endl;
            return '\0';
        }
        Node* hapus = top;
        char c = hapus->data;
        top = top->next;    
        delete hapus;      
        return c;
    }
};
int main() {
    string kata;
    Stack s;

    cout << "input kata: ";
    cin >> kata;

    for (int i = 0; i < kata.length(); i++) {
        s.push(kata[i]);
    }
    string hasil = "";
    while (!s.isEmpty()) {
        hasil += s.pop();
    }

    cout << "setelah dibalik: " << hasil << endl;

    return 0;
}
